// Managed by Browsec Deck.
// Authorize Browsec's DNS operations for the active local desktop user.
polkit.addRule(function(action, subject) {
    var allowedActions = {
        "org.freedesktop.resolve1.set-dns-servers": true,
        "org.freedesktop.resolve1.set-domains": true,
        "org.freedesktop.resolve1.set-default-route": true,
        "org.freedesktop.resolve1.revert": true,
        "org.freedesktop.resolve1.flush-caches": true
    };

    if (allowedActions[action.id] === true &&
        subject.user === "@TARGET_USER@" &&
        subject.local === true &&
        subject.active === true) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
