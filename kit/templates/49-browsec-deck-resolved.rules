// Managed by Browsec Deck.
// Allow only the per-link DNS operations used by Browsec.
polkit.addRule(function(action, subject) {
    var allowedActions = {
        "org.freedesktop.resolve1.set-dns-servers": true,
        "org.freedesktop.resolve1.set-domains": true,
        "org.freedesktop.resolve1.set-default-route": true,
        "org.freedesktop.resolve1.revert": true
    };

    if (allowedActions[action.id] === true &&
        subject.user === "@TARGET_USER@" &&
        subject.local === true &&
        subject.active === true) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
