// Managed by Browsec Deck.
// Allow the active local Steam Deck user to configure per-link DNS through
// systemd-resolved without an authentication dialog.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.resolve1.") === 0 &&
        subject.user === "@TARGET_USER@" &&
        subject.local === true &&
        subject.active === true) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
