{
  "processPathRegexpMap": [
    {
      "sourcePathRegexp": [
        "[sS]team",
        "[sS]teamwebhelper",
        "[sS]teamapps",
        "[cC]ompatdata",
        "[pP]roton",
        "[pP]ressure-vessel"
      ],
      "toPathRegexps": [
        "(?i)(^|/)steam($|/)",
        "(?i)steamwebhelper",
        "(?i)steamservice",
        "(?i)/steamapps/",
        "(?i)/compatdata/",
        "(?i)proton",
        "(?i)pressure-vessel"
      ],
      "smartRulesPreset": {
        "key": "deck-steam",
        "title": "Steam + all Steam games",
        "description": "Steam client, native games, Proton games and games on the SD card.",
        "platforms": [
          "linux"
        ],
        "showForModes": [
          "proxyOnly"
        ]
      }
    },
    {
